# Noi Solar / LiMu cloud credentials
NOI_BASE_URL=https://lmsolar.wyadmin.com
NOI_ACCOUNT=your-email@example.com
NOI_PASSWORD=your-noi-solar-password
NOI_NODE_ID=your-device-node-id

# Device metadata shown in Home Assistant
DEVICE_NAME=Noi Solar LTW
DEVICE_MODEL=LTW2430
DEVICE_MANUFACTURER=Y&H / Noi Solar

# MQTT / Home Assistant
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=noi_solar
HA_DISCOVERY_PREFIX=homeassistant

# Polling
POLL_INTERVAL=60
TOKEN_REFRESH_SECONDS=3600
